+[functions.slide-ai]
+verify_jwt = false
diff --git a/supabase/functions/slide-ai/index.ts b/supabase/functions/slide-ai/index.ts
new file mode 100644
index 0000000..91e9335
--- /dev/null
+++ b/supabase/functions/slide-ai/index.ts
@@ -0,0 +1,73 @@
+// Matnni tayyor slaydlarga bo‘ladi (faqat admin). AI matn yozmaydi: jumlalar raqamlanadi, AI faqat guruhlaydi va dizayn tanlaydi.
+// Secrets: GEMINI_API (kalit), ixtiyoriy GEMINI_MODEL (standart: gemini-2.5-flash). SUPABASE_URL va SUPABASE_ANON_KEY avtomatik.
+import { createClient } from "jsr:@supabase/supabase-js@2";
+import { LAYOUTS, MAX_CHARS, MAX_SLIDES, MAX_UNITS, build, fallbackPlan, splitUnits, validPlan } from "./logic.ts";
+
+const cors = { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Headers": "authorization, x-client-info, apikey, content-type" };
+const json = (b: unknown, status = 200) => new Response(JSON.stringify(b), { status, headers: { ...cors, "Content-Type": "application/json" } });
+
+const PROMPT = `Sen faqat dizayn muharririsan. Senga raqamlangan jumlalar beriladi. Matnni O‘ZGARTIRMA, yangi so‘z QO‘SHMA, hech narsani tushirib qoldirma.
+Vazifang: ketma-ket jumlalarni slaydlarga guruhlash (har slaydda 1-3 jumla, jami eng ko‘pi ${MAX_SLIDES} slayd) va har slayd uchun dizayn tanlash.
+Qoidalar:
+- Slaydlar jumlalarni TARTIB bilan, oraliq tashlamasdan, takrorlamasdan qoplashi shart: birinchi slayd from=0 dan boshlanadi, keyingisining from'i oldingisining to+1'i, oxirgisi eng oxirgi jumlada tugaydi.
+- Mazmunan yaqin jumlalarni bitta slaydga qo‘y. Qisqa, kuchli jumla alohida slaydga yarashadi.
+- bg: 0 indigo, 1 firuza, 2 tun ko‘k, 3 tong (iliq), 4 och ko‘k, 5 qog‘oz, 6 qora. Kayfiyatga mos tanla, ketma-ket slaydlarda bir xil rangni takrorlayvermasdan, lekin uyg‘un bo‘lsin.
+- layout: "quote" (iqtibos/aforizm), "big" (juda qisqa bitta ibora, 70 belgigacha), "plain" (oddiy matn), "title_body" (birinchi jumla sarlavha, qolgani matn; kamida 2 jumla).
+Faqat JSON qaytar.`;
+
+async function askGemini(key: string, units: string[]) {
+  const model = Deno.env.get("GEMINI_MODEL") ?? "gemini-2.5-flash";
+  const numbered = units.map((u, i) => `${i}: ${u}`).join("\n");
+  const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", "x-goog-api-key": key },
+    body: JSON.stringify({
+      systemInstruction: { parts: [{ text: PROMPT }] },
+      contents: [{ role: "user", parts: [{ text: numbered }] }],
+      generationConfig: {
+        temperature: 0.2,
+        responseMimeType: "application/json",
+        responseSchema: {
+          type: "OBJECT",
+          properties: { slides: { type: "ARRAY", items: { type: "OBJECT",
+            properties: { from: { type: "INTEGER" }, to: { type: "INTEGER" }, bg: { type: "INTEGER" }, layout: { type: "STRING", enum: [...LAYOUTS] } },
+            required: ["from", "to", "bg", "layout"] } } },
+          required: ["slides"],
+        },
+      },
+    }),
+  });
+  if (!res.ok) throw new Error(`Gemini ${res.status}`);
+  const data = await res.json();
+  return JSON.parse(data?.candidates?.[0]?.content?.parts?.[0]?.text ?? "null");
+}
+
+Deno.serve(async (req) => {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: cors });
+  if (req.method !== "POST") return json({ error: "method" }, 405);
+
+  // Faqat kirgan admin.
+  const token = (req.headers.get("Authorization") ?? "").replace(/^Bearer\s+/i, "");
+  const sb = createClient(Deno.env.get("SUPABASE_URL")!, Deno.env.get("SUPABASE_ANON_KEY")!, {
+    global: { headers: { Authorization: `Bearer ${token}` } }, auth: { persistSession: false },
+  });
+  const { data: u } = await sb.auth.getUser(token);
+  if (!u?.user) return json({ error: "kirish kerak" }, 401);
+  const { data: prof } = await sb.from("profiles").select("role").single();
+  if (prof?.role !== "admin") return json({ error: "ruxsat yo‘q" }, 403);
+
+  const body = await req.json().catch(() => ({}));
+  const text = typeof body.text === "string" ? body.text.trim() : "";
+  if (text.length < 10) return json({ error: "Matn juda qisqa" }, 400);
+  if (text.length > MAX_CHARS) return json({ error: `Matn juda uzun (${MAX_CHARS} belgigacha)` }, 400);
+  const units = splitUnits(text);
+  if (units.length > MAX_UNITS) return json({ error: "Jumlalar juda ko‘p" }, 400);
+
+  const key = Deno.env.get("GEMINI_API") ?? Deno.env.get("GEMINI_API_KEY") ?? Deno.env.get("gemini_api") ?? "";
+  let plan = null, ai = false, note = "";
+  if (key && units.length > 1) {
+    try { plan = validPlan(await askGemini(key, units), units.length); ai = !!plan; if (!plan) note = "AI javobi yaroqsiz, qoida asosida bo‘lindi"; }
+    catch (e) { note = `AI ishlamadi (${e instanceof Error ? e.message : "xato"}), qoida asosida bo‘lindi`; }
+  } else if (!key) note = "AI kaliti topilmadi, qoida asosida bo‘lindi";
+  return json({ slides: build(units, plan ?? fallbackPlan(units)), ai, note });
+});
diff --git a/supabase/functions/slide-ai/logic.ts b/supabase/functions/slide-ai/logic.ts
new file mode 100644
index 0000000..96285dd
--- /dev/null
+++ b/supabase/functions/slide-ai/logic.ts
@@ -0,0 +1,69 @@
+// Matnni slaydlarga bo‘lish mantiqi (AI'ga bog‘liq emas, sinash mumkin).
+// Kafolat: slayd matni FAQAT asl matn bo‘laklaridan (jumlalardan) yig‘iladi; AI faqat bo‘laklar tartibini guruhlaydi va dizayn tanlaydi.
+export const MAX_SLIDES = 10;
+export const MAX_UNITS = 80;
+export const MAX_CHARS = 4000;
+export const LAYOUTS = ["quote", "big", "plain", "title_body"] as const;
+export type Layout = (typeof LAYOUTS)[number];
+export type Plan = { from: number; to: number; bg: number; layout: Layout };
+export type OutSlide = { bg: number; layout: Layout; parts: string[] };
+
+/** Matnni jumlalarga bo‘ladi (abzas chegarasi ham jumla chegarasi). */
+export function splitUnits(text: string): string[] {
+  const out: string[] = [];
+  for (const para of text.replace(/\r/g, "").split(/\n\s*\n|\n/)) {
+    const p = para.trim();
+    if (!p) continue;
+    for (const s of p.split(/(?<=[.!?…])["»”’)]*\s+/)) if (s.trim()) out.push(s.trim());
+  }
+  return out;
+}
+
+/** AI rejasi to‘g‘ri bo‘lsagina qabul qilinadi: butun matn, tartib bilan, takrorsiz va qoldiqsiz qoplanishi shart. */
+export function validPlan(raw: unknown, n: number): Plan[] | null {
+  const arr = (raw as { slides?: unknown })?.slides;
+  if (!Array.isArray(arr) || !arr.length || arr.length > MAX_SLIDES) return null;
+  const plan: Plan[] = [];
+  let next = 0;
+  for (const s of arr) {
+    const { from, to, bg, layout } = (s ?? {}) as Record<string, unknown>;
+    if (!Number.isInteger(from) || !Number.isInteger(to) || !Number.isInteger(bg)) return null;
+    if (from !== next || (to as number) < (from as number) || (to as number) >= n) return null;
+    if ((bg as number) < 0 || (bg as number) > 6 || !LAYOUTS.includes(layout as Layout)) return null;
+    plan.push({ from: from as number, to: to as number, bg: bg as number, layout: layout as Layout });
+    next = (to as number) + 1;
+  }
+  return next === n ? plan : null;
+}
+
+/** AI ishlamasa: jumlalarni ~200 belgigacha yig‘ib, ranglarni navbatma-navbat qo‘yadi. */
+export function fallbackPlan(units: string[]): Plan[] {
+  const plan: Plan[] = [];
+  let from = 0, len = 0;
+  const dark = [0, 1, 2, 6];
+  units.forEach((u, i) => {
+    if (i > from && len + u.length > 200) {
+      plan.push({ from, to: i - 1, bg: dark[plan.length % dark.length]!, layout: "plain" });
+      from = i; len = 0;
+    }
+    len += u.length + 1;
+  });
+  plan.push({ from, to: units.length - 1, bg: dark[plan.length % dark.length]!, layout: "plain" });
+  while (plan.length > MAX_SLIDES) { // juda uzun matn: oxirgi slaydlarni birlashtiradi
+    const b = plan.pop()!; plan[plan.length - 1]!.to = b.to;
+  }
+  return plan;
+}
+
+/** Rejani tayyor slaydlarga aylantiradi. Matn faqat units'dan olinadi. */
+export function build(units: string[], plan: Plan[]): OutSlide[] {
+  return plan.map((p) => {
+    const group = units.slice(p.from, p.to + 1);
+    const text = group.join(" ");
+    let layout = p.layout;
+    if (layout === "big" && text.length > 70) layout = "plain";
+    if (layout === "title_body" && group.length < 2) layout = "plain";
+    const parts = layout === "title_body" ? [group[0]!, group.slice(1).join(" ")] : [text];
+    return { bg: p.bg, layout, parts };
+  });
+}
diff --git a/test/slideai.test.ts b/test/slideai.test.ts
new file mode 100644
index 0000000..fba6ec0
--- /dev/null
+++ b/test/slideai.test.ts
@@ -0,0 +1,18 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { build, fallbackPlan, splitUnits, validPlan } from "../supabase/functions/slide-ai/logic.ts";
+
+const text = "Birinchi jumla. Ikkinchi jumla! Uchinchi?\n\nTo‘rtinchi abzas jumlasi. Beshinchi.";
+test("jumlalarga bo‘ladi", () => assert.equal(splitUnits(text).length, 5));
+test("reja butun matnni qoplamasa rad etiladi", () => {
+  const ok = { slides: [{ from: 0, to: 2, bg: 0, layout: "plain" }, { from: 3, to: 4, bg: 1, layout: "quote" }] };
+  assert.ok(validPlan(ok, 5));
+  assert.equal(validPlan({ slides: [{ from: 0, to: 2, bg: 0, layout: "plain" }] }, 5), null);       // qoldiq
+  assert.equal(validPlan({ slides: [{ from: 0, to: 2, bg: 0, layout: "plain" }, { from: 2, to: 4, bg: 0, layout: "plain" }] }, 5), null); // takror
+  assert.equal(validPlan({ slides: [{ from: 0, to: 4, bg: 9, layout: "plain" }] }, 5), null);       // yomon rang
+});
+test("slayd matni faqat asl jumlalardan", () => {
+  const u = splitUnits(text);
+  const out = build(u, fallbackPlan(u));
+  assert.equal(out.flatMap((s) => s.parts).join(" "), u.join(" "));
+});
-- 
2.43.0

