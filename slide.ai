+              {aiMsg && <p role="status" className="mt-2 text-[13px] text-muted">{aiMsg}</p>}
+            </div>
+          )}
           {slideMode && <SlideEditor slides={slides} onChange={setSlides} u={u} c={c} />}
           {!slideMode && <textarea value={body} onChange={(e) => setBody(e.target.value)} maxLength={kind === "thought" ? 8000 : 280}
             aria-label={kind === "thought" ? u("Matn") : u("Qisqa matn")}
diff --git a/src/lib/api.ts b/src/lib/api.ts
index d073c6e..2d88ce4 100644
--- a/src/lib/api.ts
+++ b/src/lib/api.ts
@@ -204,3 +204,18 @@ export async function removeVideo(url: string | null) {
 
 /** Fikr rasmi uchun: yuklash bitta (video bilan bir xil bucket). */
 export const uploadImage = uploadVideo;
+
+/* ---------- AI: matnni slaydlarga bo‘lish (Edge Function slide-ai, faqat admin) ---------- */
+export type AiSlide = { bg: number; layout: "quote" | "big" | "plain" | "title_body"; parts: string[] };
+export async function aiSlides(text: string): Promise<{ slides: AiSlide[]; ai: boolean; note: string }> {
+  const token = (await supabase.auth.getSession()).data.session?.access_token;
+  if (!token) throw new Error("kirish kerak");
+  const res = await fetch(`${API_URL}/functions/v1/slide-ai`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", apikey: import.meta.env.VITE_SUPABASE_ANON_KEY as string, Authorization: `Bearer ${token}` },
+    body: JSON.stringify({ text }),
+  });
+  const out = await res.json().catch(() => null);
+  if (!res.ok || !Array.isArray(out?.slides)) throw new Error(out?.error ?? `xato ${res.status}`);
+  return out;
+}
diff --git a/src/lib/slides.ts b/src/lib/slides.ts
index dba4882..dfcddd5 100644
--- a/src/lib/slides.ts
+++ b/src/lib/slides.ts
@@ -84,3 +84,18 @@ export const slideUrls = (sl?: Slide[] | null): string[] =>
   (sl ?? []).flatMap((s) => [s.bg.image, ...s.els.map((e) => (e.type === "image" ? e.src : null))].filter((x): x is string => !!x));
 
 export const hasContent = (sl: Slide[]) => sl.length > 0 && sl.some((s) => s.els.length > 0);
+
+/** AI rejasi (matn faqat asl jumlalardan) → tayyor slaydlar. Och fonlarda matn to‘q rangda. */
+export function slidesFromPlan(plan: Array<{ bg: number; layout: string; parts: string[] }>): Slide[] {
+  return plan.slice(0, MAX_SLIDES).map((p) => {
+    const bgIdx = Math.min(Math.max(p.bg, 0), BGS.length - 1);
+    const color = bgIdx === 4 || bgIdx === 5 ? "#141b45" : "#ffffff";
+    const t = p.parts[0] ?? "";
+    const els: El[] =
+      p.layout === "title_body" && p.parts[1] ? [newText("title", t, { y: 30, color }), newText("plain", p.parts[1], { y: 62, size: 20, w: 78, color })]
+      : p.layout === "quote" ? [newText("quote", t, { color, size: t.length > 140 ? 22 : 28 })]
+      : p.layout === "big" ? [newText("title", t, { y: 50, size: t.length > 40 ? 46 : 60, w: 88, color })]
+      : [newText("plain", t, { color, size: t.length > 160 ? 20 : t.length > 90 ? 24 : 28 })];
+    return { bg: { css: BGS[bgIdx]!, image: null, dim: 0 }, els };
+  });
+}
diff --git a/supabase/config.toml b/supabase/config.toml
index 2e0701c..fbbcc05 100644
--- a/supabase/config.toml
+++ b/supabase/config.toml
@@ -4,3 +4,7 @@ project_id = "svihzrgndgnketairtog"
